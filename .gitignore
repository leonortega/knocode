# === Project-specific ===
# Knocode runtime data (database, index, logs, cache)
.knocode/data.db
.knocode/data.db-wal
.knocode/data.db-shm
.knocode/index/
.knocode/logs/
.knocode/cache/
.knocode/artifacts/

# Knocode config is tracked, but runtime state is not
# .knocode/config.toml  ← tracked (project config)
# .knocode/profile.json ← tracked (project profile)
# .knocode/skills/      ← tracked (skill library)

# Evaluation results (generated)
eval/results/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Environment / secrets
.env
.env.*
!.env.example

# Node.js (for eval tooling)
node_modules/
package-lock.json
yarn.lock
.pnpm-lock.yaml

# === Build artifacts ===
*.o
*.so
*.dylib
*.dll
*.rlib
*.d
*.dSYM/

# === Experiments (contain their own target/ build artifacts) ===
experiments/

